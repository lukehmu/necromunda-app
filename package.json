{
  "name": "necromunda-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b --noEmit",
    "prepare": "lefthook install",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy -c worker/wrangler.jsonc",
    "worker:types": "wrangler types -c worker/wrangler.jsonc worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lefthook": "^2.1.14",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.0.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260925.1": true,
    "lefthook@2.1.14": true
  }
}
